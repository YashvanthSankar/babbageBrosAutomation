# Production Convex database; credentials must match this deployment.
CONVEX_DEPLOYMENT=prod:groovy-sheep-854
NEXT_PUBLIC_CONVEX_URL=https://groovy-sheep-854.convex.cloud
CONVEX_BACKEND_SECRET=
APP_DOMAIN=your-domain.example
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret
PROFESSOR_EMAIL=professor@iiitdm.ac.in
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=264891
OMNIDIM_FROM_NUMBER_ID=6574
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FACULTY_ADVISER_EMAIL=
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact email of an explicitly approved demo Google account; personal calendars receive real booking events.
GOOGLE_CALENDAR_ACCOUNT=
TOKEN_ENCRYPTION_KEY=

# Public demo always simulates by default. Live testing is opt-in and must use
# consenting test destinations, never uploaded student contacts.
DEMO_LIVE_AUTOMATIONS=false
DEMO_AUTOMATION_EMAIL=
DEMO_AUTOMATION_PHONE=
# Live test requirements: Resend + verified sender + pinned test inbox, and/or
# OmniDimension credentials + pinned E.164 test number. Live messages/calls use
# fixed synthetic content. Import-triggered providers and manual demo email
# have separate daily claims; digest/adviser claims are per ISO week.
# Weekly aggregate runs need a separately configured VPS cron job; manual runs work without CRON_SECRET.

# Demo sign-in always accepts an @iiitdm.ac.in email, full name, valid Indian
# E.164 phone number, and any non-empty password. Passwords are never stored.
# Use only synthetic data in this competition demo.

# Optional upload cap for roster/attendance/marks imports, in bytes.
# Default: 2097152 (2 MiB).
MAX_UPLOAD_BYTES=2097152
