DATABASE_URL=postgres://postgres:password@localhost:5432/babbage
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PROFESSOR_EMAIL=professor@iiitdm.ac.in

# OPT-IN demo sign-in: email + any NON-EMPTY password. Disabled by default.
# Accepts the exact PROFESSOR_EMAIL as admin and roster @iiitdm.ac.in students.
# This is IMPERSONATION-GRADE access and is for SYNTHETIC DEMO DATA ONLY.
# Never enable it on a deployment holding real student data. Passwords are
# never stored or verified, and it grants NO Google Calendar authorization.
DEMO_AUTH_ENABLED=false
