# PostgreSQL connection string supplied by the database owner.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Use a long random value in hosted environments.
SESSION_SECRET=replace-with-a-long-random-string

# Optional demo identity overrides.
DEMO_TEACHER_EMAIL=demo@attendly.local
DEMO_TEACHER_NAME=Demo Faculty

# Optional upload cap in bytes. Default: 2097152 (2 MiB).
MAX_UPLOAD_BYTES=2097152
