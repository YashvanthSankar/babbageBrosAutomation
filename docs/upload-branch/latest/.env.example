# Generated by `npx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Set the same random value in Next.js and the Convex deployment environment.
CONVEX_BACKEND_SECRET=replace-with-a-long-random-string

# Use a long random value in hosted environments.
SESSION_SECRET=replace-with-a-long-random-string

# Optional demo identity overrides.
DEMO_TEACHER_EMAIL=demo@attendly.local
DEMO_TEACHER_NAME=Demo Faculty

# Optional upload cap in bytes. Default: 1048576 (1 MiB).
MAX_UPLOAD_BYTES=1048576

